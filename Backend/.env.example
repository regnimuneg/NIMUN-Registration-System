# OC Conference '27 backend. Copy to Backend/.env (git-ignored) and fill in
# values from the NEW '27 Supabase project, never the NIMUN'26 one.

# Preferred: full connection string from Supabase > Project Settings > Database
DATABASE_URL=postgresql://postgres.REPLACE_OC27_PROJECT_REF:REPLACE_OC27_DB_PASSWORD@REPLACE_OC27_POOLER_HOST:5432/postgres

# Alternative to DATABASE_URL (only used when DATABASE_URL is empty)
SUPABASE_URL=https://REPLACE_OC27_PROJECT_REF.supabase.co
DB_PASSWORD=REPLACE_OC27_DB_PASSWORD
SUPABASE_SERVICE_ROLE_KEY=REPLACE_OC27_SERVICE_ROLE_KEY

PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Local testing only; ignored when NODE_ENV=production
MOCK_AUTH_ENABLED=false
MOCK_ADMIN_EMAIL=admin@example.com
MOCK_ADMIN_PASSWORD=change-me
