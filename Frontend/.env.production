# OC Conference '27 branch: placeholder on purpose.
# Points at nothing until the '27 backend exists, so a build of this branch
# can never talk to the live NIMUN'26 API (server.nimuneg.org).
# A VITE_API_URL set in the hosting dashboard overrides this file.
VITE_API_URL=https://REPLACE-WITH-OC27-API-URL.example.com
